Isthmus: force Steam's web helper to render in software, in-process.

Fixes black Steam windows on the macOS driver.

--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -497,6 +497,26 @@
     RtlFreeHeap( GetProcessHeap(), 0, cur_dirW );
     RtlFreeUnicodeString( &desktopW );
     RtlFreeUnicodeString( &titleW );
+    return ret;
+}
+
+/* Isthmus: Steam's Chromium-based web helper paints black windows through
+ * the macOS driver when it uses GPU compositing or a separate GPU process.
+ * Force software rendering in-process for the browser (top-level) process;
+ * Chromium propagates the switches to its children. Same approach as
+ * CrossOver bugs 13322 / 17315 / 21883. */
+static WCHAR *isthmus_steamwebhelper_cmdline( const WCHAR *cmdline )
+{
+    static const WCHAR extra[] = L" --no-sandbox --in-process-gpu --disable-gpu";
+    WCHAR *ret;
+
+    if (!cmdline || !wcsstr( cmdline, L"steamwebhelper.exe" )) return NULL;
+    if (wcsstr( cmdline, L"--type=" ) || wcsstr( cmdline, L"--in-process-gpu" )) return NULL;
+    if (!(ret = RtlAllocateHeap( GetProcessHeap(), 0, (lstrlenW( cmdline ) + ARRAY_SIZE( extra )) * sizeof(WCHAR) )))
+        return NULL;
+    lstrcpyW( ret, cmdline );
+    lstrcatW( ret, extra );
+    FIXME( "HACK: appending %s to Steam web helper command line\n", debugstr_w( extra ) );
     return ret;
 }
 
@@ -543,6 +563,12 @@
     {
         if (!(tidy_cmdline = get_file_name( cmd_line, name, ARRAY_SIZE(name) ))) return FALSE;
         app_name = name;
+    }
+
+    if ((p = isthmus_steamwebhelper_cmdline( tidy_cmdline )))
+    {
+        if (tidy_cmdline != cmd_line) HeapFree( GetProcessHeap(), 0, tidy_cmdline );
+        tidy_cmdline = p;
     }
 
     /* CW Hack 24938 */
