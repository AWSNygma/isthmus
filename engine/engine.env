# Pinned versions for the Isthmus engine. Bump these deliberately; CI and
# local builds both read this file.

# CodeWeavers' LGPL source release (Wine + their patches).
CX_SOURCE_VERSION=26.3.0
CX_SOURCE_URL="https://media.codeweavers.com/pub/crossover/source/crossover-sources-${CX_SOURCE_VERSION}.tar.gz"

# Must match WINE_MONO_VERSION / GECKO_VERSION in the Wine tree.
WINE_MONO_VERSION=10.4.1
WINE_GECKO_VERSION=2.47.4

# Graphics translation layers (prebuilt upstream releases, LGPL / zlib).
DXMT_VERSION=v0.80
DXVK_MACOS_VERSION=v1.10.3-20230507-repack

# Engine version string shipped to the app: <cx source>-<isthmus revision>
ENGINE_REVISION=2
ENGINE_VERSION="${CX_SOURCE_VERSION}-i${ENGINE_REVISION}"
